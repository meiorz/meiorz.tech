      },
      {
        "source": "/blog{,/**}",
        "destination": "/archive/blog/",
        "type": 301
      },
      {
        "source": "/gallery{,/**}",
        "destination": "/archive/",
        "type": 301
      },
      {
        "source": "/feed.xml",
